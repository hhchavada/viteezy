# Viteezy frontend — environment variables
# Copy this file to `.env` and adjust values for your environment.
#
#   cp .env.example .env
#
# All variables use the NEXT_PUBLIC_ prefix so they are available in the browser.
# Rebuild the app (or restart `pnpm dev`) after changing any value.


# -----------------------------------------------------------------------------
# Node.js API (auth, products, cart, checkout, account, etc.)
# Default local backend: viteezy-v2-BE on port 8050
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8050/api/v1

# -----------------------------------------------------------------------------
# Quiz Engine v2 API (quiz session, questions, recommendations)
# Points at the same Node backend as NEXT_PUBLIC_API_BASE_URL.
# Do not use a legacy Python /py/ URL — the AI chat quiz has been removed.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_QUIZ_URL=http://localhost:8050/api/v1

# -----------------------------------------------------------------------------
# Admin panel origin (used for preview links from the storefront home page)
# Default local admin: viteezy-v2-admin on port 8081
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:8081

# -----------------------------------------------------------------------------
# Socket.IO server for maintenance mode (MaintenanceGate)
# Usually the Node backend origin without /api/v1 — e.g. http://localhost:8050
# Leave empty to disable maintenance socket checks in local dev.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:8050

# -----------------------------------------------------------------------------
# LAN / mobile testing (same Wi-Fi)
# Use your machine's local IP instead of localhost so other devices can reach APIs.
# Find IP: ipconfig (Windows) or ifconfig (Mac/Linux)
# Also set ALLOWED_DEV_ORIGINS so Next.js 16 allows HMR from that IP.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://192.168.0.34:8050/api/v1
# NEXT_PUBLIC_API_QUIZ_URL=http://192.168.0.34:8050/api/v1
# NEXT_PUBLIC_ADMIN_ORIGIN=http://192.168.0.34:8081
# NEXT_PUBLIC_SERVER_URL=http://192.168.0.34:8050
# ALLOWED_DEV_ORIGINS=192.168.0.34,192.168.0.34:8080

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://staging-v2.viteezy.com/api/v1
# NEXT_PUBLIC_API_QUIZ_URL=https://staging-v2.viteezy.com/api/v1
# NEXT_PUBLIC_ADMIN_ORIGIN=https://staging-admin.viteezy.com
# NEXT_PUBLIC_SERVER_URL=https://staging-v2.viteezy.com
